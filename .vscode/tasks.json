{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Deploy Help — Safe Deploy Governance",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy", "Bypass",
				"-File", "..\\..\\van2\\scripts\\deploy-safe.ps1",
				"-Action", "help"
			],
			"problemMatcher": []
		},
		{
			"label": "Deploy Storage Isolated (van1)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts/deploy-storage-isolated.ps1",
				"-ConfirmDeploy",
				"APPROVE:van1:van-merchant",
				"-ConfirmFile",
				"storage.rules",
				"-ConfirmImpact",
				"SELF:van1",
				"-InteractiveConfirm"
			],
			"problemMatcher": []
		},
		{
			"label": "Deploy Firestore Isolated (van1)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts/deploy-firestore-isolated.ps1",
				"-ConfirmDeploy",
				"APPROVE:van1:van-merchant",
				"-ConfirmFile",
				"van2/firestore.rules",
				"-ConfirmImpact",
        "SHARED:van1,van2,van3,van4",
				"-InteractiveConfirm"
			],
			"problemMatcher": []
		},
		{
			"label": "Deploy Isolated (van1)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts/deploy-isolated.ps1",
				"-ConfirmDeploy",
				"APPROVE:van1:van-merchant",
				"-ConfirmFile",
				"firestore.rules,storage.rules,firebase.json",
				"-ConfirmImpact",
				"MIXED:shared-firestore+self-van1",
				"-InteractiveConfirm"
			],
			"problemMatcher": []
		},
		{
			"label": "DO NOT USE - Deploy Rules (van-merchant)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts/deploy-van-merchant-rules.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Deploy Function verifyTopUpSlip Isolated (van1)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts/deploy-functions-isolated.ps1",
				"-FunctionName",
				"verifyTopUpSlip",
				"-ConfirmDeploy",
				"APPROVE:van1:van-merchant",
				"-ConfirmFile",
				"functions",
				"-ConfirmImpact",
				"SELF:van1",
				"-InteractiveConfirm"
			],
			"problemMatcher": []
		},
		{
			"label": "Flutter Build APK",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build",
				"apk"
			],
			"problemMatcher": [
				"$flutter"
			],
			"group": "build"
		}
	]
}