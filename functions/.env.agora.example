# ตัวอย่างไฟล์สำหรับเก็บค่า Agora
AGORA_APP_ID=YOUR_APP_ID
AGORA_APP_CERTIFICATE=YOUR_APP_CERTIFICATE
AGORA_TOKEN_TTL_SECONDS=3600

# วิธีใช้จริง
# 1. เปลี่ยนค่า YOUR_APP_ID และ YOUR_APP_CERTIFICATE เป็นของจริง
# 2. ตั้งค่าด้วย firebase CLI:
#    firebase functions:config:set agora.app_id="YOUR_APP_ID" agora.app_certificate="YOUR_APP_CERTIFICATE" agora.token_ttl_seconds="3600"
# 3. deploy ใหม่
#    firebase deploy --only functions:initiateCall,functions:callUser
