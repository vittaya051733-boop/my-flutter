# ตัวอย่างไฟล์สำหรับเก็บค่า Agora
AGORA_APP_ID=YOUR_APP_ID
AGORA_APP_CERTIFICATE=YOUR_APP_CERTIFICATE
AGORA_APP_TTL_SECONDS=3600

# วิธีใช้จริง
# 1. เปลี่ยนค่า YOUR_APP_ID และ YOUR_APP_CERTIFICATE เป็นของจริง
# 2. ตั้งค่า secrets ด้วย firebase CLI:
#    firebase functions:secrets:set AGORA_APP_ID
#    firebase functions:secrets:set AGORA_APP_CERTIFICATE
#    firebase functions:secrets:set AGORA_APP_TTL_SECONDS
# 3. deploy ใหม่แบบระบุ codebase:
#    firebase deploy --only "functions:van1:initiateCall,functions:van1:callUser"
